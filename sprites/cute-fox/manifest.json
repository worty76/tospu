{
  "schemaVersion": 1,
  "id": "cute-fox",
  "name": "Cute Fox",
  "author": "you",
  "license": "Personal use",
  "renderer": "spritesheet",
  "frame": {
    "width": 242,
    "height": 199,
    "displayHeight": 120
