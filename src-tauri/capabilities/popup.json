{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popup",
  "description": "The popup window only listens for show events and reports hit-rect/finished.",
  "windows": ["popup"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-set-hit-rect",
    "allow-popup-finished"
  ]
}
