{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window manages messages, schedule, character and general options.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-settings-view",
    "allow-add-message",
    "allow-update-message",
    "allow-delete-message",
    "allow-save-settings",
    "allow-set-launch-at-login",
    "allow-show-test-popup",
    "allow-open-data-folder",
    "allow-open-sprites-folder",
    "allow-open-pack-guide",
    "allow-reload-files",
    "allow-finish-onboarding"
  ]
}
